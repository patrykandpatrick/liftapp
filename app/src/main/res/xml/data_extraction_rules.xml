<?xml version="1.0" encoding="utf-8"?><!--
    What Android's own backup takes on API 31 and above — see backup_rules.xml for the older path,
    which this deliberately mirrors.

    Device transfer takes the same set: it moves to a device the user is holding, so there is
    nothing to withhold from it that cloud backup may have.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore/" />
    </device-transfer>
</data-extraction-rules>
